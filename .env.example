# Copy to .env for LOCAL use only. Never commit real values. On Render these are set as environment variables / secrets.
DATABASE_URL=postgres://user:password@host:5432/dbname      # REQUIRED. Server-side only.
ALLOWED_ORIGINS=https://alcapon264-cell.github.io           # exact origins, comma-separated. Empty = refuse every browser origin.
PORT=8080
SAMPLE_INTERVAL_SEC=15          # 5..300. Lower values are capped by MAX_REQUESTS_PER_SEC.
MAX_REQUESTS_PER_SEC=0.25       # hard ceiling 0.5 (the stated keyless limit)
TRUSTED_PROXY_HOPS=1            # how many proxies append to X-Forwarded-For (UNVERIFIED for Render, confirm in S3)
RECORDER_ENABLED=1              # 0 = API/WebSocket-only instance
# READER_DATABASE_URL=          # optional SELECT-only role for the HTTP/WS paths
# PGSSL=require                 # only for external DB URLs; internal Render URLs need no TLS flag
# JUPITER_API_KEY=              # optional; set BOTH of these or neither. Header name comes from Jupiter's docs.
# JUPITER_API_KEY_HEADER=
# STATUS_TOKEN=                # optional, >= 24 printable chars (use 32+ random). Enables GET /internal/status (Authorization: Bearer <token>). Unset = endpoint does not exist.

# Optional per-market price plausibility range "min,max" (defaults: SOL 0.5,50000  ETH 20,500000  BTC 1000,5000000)
# PRICE_RANGE_SOL=
# PRICE_RANGE_ETH=
# PRICE_RANGE_BTC=

# ---- Perps gateway (/v1/perps/jup/*) ----
# Reads (positions, market-stats) are always on. The transaction routes (increase / decrease / execute) answer 403 execution_disabled
# unless BOTH of the next two are set. Real-money execution is NOT approved: leave them unset.
# PERPS_EXECUTION_ENABLED=
# GATEWAY_TICKET_SECRET=         # >= 32 random characters; Render secret only. Signs the per-transaction tickets /execute requires.
# GATEWAY_UPSTREAM_PER_MIN=12    # shared budget for ALL gateway calls to Jupiter (1..30), so users can never starve the recorder
# GATEWAY_POSITIONS_PER_MIN=20   # per client IP
# GATEWAY_JUP_TRANSACTION_TYPE=  # optional, UNVERIFIED: sent to Jupiter as "transactionType" only when set. Leave unset.
# NOTE r117: even with all of the above set, execution stays LOCKED in code (src/perps-program.js EXECUTE_CONTRACT_VERIFIED=false)
# until Jupiter's Perps REST contract is verified. The routes then answer 403 execution_contract_unverified.

# ---- r121 VIEW-ONLY markets (free sources only; zero monthly cost) ----
# Prices: Hyperliquid public API (no key): main perps for HYPE ZEC JUP NEAR BNB, Trade.xyz HIP-3 markets for SNDK SPCX SKHYNIX.
# Cross-check: crypto against CoinGecko Demo (free key); equities against their own Hyperliquid oracle price.
# These markets can never be traded (not in MARKETS/CUSTODY; the gateway refuses them by name). Logos ship in assets/logos.
# VIEW_MARKETS=HYPE,ZE
